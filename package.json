{
  "name": "bebeat",
  "version": "1.3.0",
  "description": "Flagship music production, live coding, beat-reactive modulation, and lossless mastering studio companion to Totone and Fifilm",
  "author": "Avery",
  "private": true,
  "type": "module",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "compile:electron": "esbuild electron/main.ts electron/preload.ts --bundle --platform=node --format=cjs --external:electron --external:ffmpeg-static --outdir=dist-electron --out-extension:.js=.cjs",
    "build:electron": "npm run kits:generate && npm run icon:generate && tsc --noEmit && vite build && npm run compile:electron",
    "electron:dev": "npm run compile:electron && concurrently -k \"vite\" \"wait-on http://127.0.0.1:5174 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5174 electron .\"",
    "electron:start": "npm run build:electron && electron .",
    "icon:generate": "python scripts/generate_icon.py",
    "kits:generate": "python scripts/generate_kits.py",
    "wasm:build": "cd dsp-wasm && wasm-pack build --target web --out-dir ../public/wasm",
    "test": "npx tsx --test tests/*.test.ts",
    "dist:win": "npm run build:electron && electron-builder --win --publish never",
    "dist:win:portable": "npm run build:electron && electron-builder --win portable --publish never",
    "preview": "vite preview"
  },
  "build": {
    "appId": "app.bebeat.studio",
    "productName": "Bebeat",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "node_modules/ffmpeg-static/**/*",
      "package.json"
    ],
    "asar": true,
    "asarUnpack": [
      "node_modules/ffmpeg-static/**/*"
    ],
    "extraResources": [
      {
        "from": "assets",
        "to": "assets",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "scripts/python_bridge.py",
        "to": "scripts/python_bridge.py"
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "signExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Bebeat",
      "artifactName": "Bebeat-Setup-${version}.exe"
    },
    "portable": {
      "artifactName": "Bebeat-${version}-Portable.exe"
    }
  },
  "dependencies": {
    "@tonejs/midi": "^2.0.28",
    "ffmpeg-static": "^5.3.0",
    "lucide-react": "^0.511.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tone": "^15.1.22"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.4.1",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^35.7.5",
    "electron-builder": "^26.0.12",
    "esbuild": "^0.25.12",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3",
    "vite": "^6.4.6",
    "wait-on": "^8.0.3"
  }
}
